# ========== KLA 韓国語学習アプリ 環境変数 ==========
# このファイルを .env にコピーし、値を設定してください。.env は git に commit しないこと。

# Supabase（必須: 単語2-6級・文法・チャットで使用）
# https://supabase.com でプロジェクト作成 → Settings → API から URL と anon key をコピー
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase 運用/スクリプト用（公開アプリには埋め込まない）
# Storage へのアップロードや Edge Function で使用
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# OpenAI（オプション: スクリプトでのクイズ・例文生成用。https://platform.openai.com/api-keys）
# 使用例: OPENAI_API_KEY=sk-... node scripts/generate-grammar-quiz.mjs ...
# 多言語コンテンツ（英語 JSON → zh/vi/es/id/th）: npm run content:translate-locale （TARGET_LANG=zh 必須）
# または npm run content:translate-all-locales（5言語まとめて。時間・API費用がかかります）
# OPENAI_API_KEY=sk-proj-...

# プライバシーポリシー・利用規約（任意。未設定時は src/constants/legal.ts の Notion 既定 URL を使用）
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://yourdomain.com/privacy
# EXPO_PUBLIC_TERMS_URL=https://yourdomain.com/terms
# サポート（公開ページの URL、または mailto:support@example.com）
# 未設定時はアプリ内で Notion の TOPIK NEO サポートページが既定で使われます。
# EXPO_PUBLIC_SUPPORT_URL=https://yourdomain.com/support

# RevenueCat（リリース必須。iOS は Public Apple SDK Key を設定）
# Entitlement / Offering は RevenueCat Dashboard の値に合わせてください。
# EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=appl_xxxxxxxxxxxxxxxxxxxxx
# EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=goog_xxxxxxxxxxxxxxxxxxxxx
# EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=TOPIK NEO Pro
# EXPO_PUBLIC_REVENUECAT_OFFERING_ID=default
#
# 商品ID（RevenueCat / App Store Connect / Google Play Console で一致させる）
# 未設定時は monthly / yearly / lifetime を既定値として扱います。
# EXPO_PUBLIC_IAP_PRODUCT_ID_MONTHLY=com.kla.monthly
# EXPO_PUBLIC_IAP_PRODUCT_ID_YEARLY=com.kla.yearly
# EXPO_PUBLIC_IAP_PRODUCT_ID_LIFETIME=com.kla.lifetime

# 監視（オプション）
# 現在の実装は monitoring.ts で受け、将来 Sentry 等に接続可能です。
# 監視導入時に利用する DSN をここに設定してください。
# EXPO_PUBLIC_SENTRY_DSN=https://xxxxx.ingest.sentry.io/xxxxx
# Sentry Expo プラグイン警告を避けるには、EAS 環境変数に以下も設定してください。
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxx
# 開発/検証用: 設定画面に「Sentry テスト送信」ボタンを表示
# EXPO_PUBLIC_ENABLE_SENTRY_TEST_BUTTON=true

# アカウント削除（Supabase Edge Function）
# `supabase functions deploy delete-user` を実行し、
# Secrets に SUPABASE_SERVICE_ROLE_KEY を設定してから本番公開してください。
#
# RevenueCat サーバー同期（Supabase Edge Function）
# `supabase functions deploy sync-subscription` を実行し、
# Secrets に REVENUECAT_SECRET_API_KEY を設定してください。
# 商品IDが monthly / yearly / lifetime 以外の場合は以下も設定してください。
# REVENUECAT_PRODUCT_ID_MONTHLY=monthly
# REVENUECAT_PRODUCT_ID_YEARLY=yearly
# REVENUECAT_PRODUCT_ID_LIFETIME=lifetime
# REVENUECAT_ENTITLEMENT_ID=TOPIK NEO Pro
